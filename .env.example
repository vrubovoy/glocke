# Glocke Docker Compose substitutions. Copy to .env, generate all five secrets
# independently (`openssl rand -base64 32`), and never commit the populated file.
SCHLUSSEL_WEB_URL=https://auth.localhost
SCHLOSS_URL=https://localhost
GLOCKE_DATABASE_PATH=/data/glocke.db
SCHLUSSEL_JWKS_URL=http://schlussel:4000/.well-known/jwks.json
SCHLUSSEL_INTERNAL_URL=http://schlussel:4000
GLOCKE_TO_SCHLUSSEL_HMAC_KEY_ID=glocke-v1
GLOCKE_TO_SCHLUSSEL_HMAC_SECRET=replace-with-a-distinct-high-entropy-secret
JWT_ISSUER=schlussel
# Exact browser origins allowed to read Glocke notification state with a JWT.
GLOCKE_ALLOWED_ORIGINS=https://localhost,https://auth.localhost,https://kuvert.localhost,https://tafel.localhost,https://zettel.localhost,https://glocke.localhost
KUVERT_URL=https://kuvert.localhost
TAFEL_URL=https://tafel.localhost

# /exports/me verifies access JWTs and exact Glocke export delegations through
# this same JWKS/issuer. Glocke has no export secret, artifact directory, or ZIP
# quota; Schlussel owns all-services retention and storage limits.

# Every producer -> Glocke. Each secret must match that producer's own
# *_TO_GLOCKE_HMAC_SECRET setting (see its own .env.example) and must
# remain distinct from every other credential here, including
# GLOCKE_TO_SCHLUSSEL_HMAC_SECRET.
GLOCKE_EVENT_SOURCES=schlussel,kuvert,tafel,zettel
SCHLUSSEL_TO_GLOCKE_HMAC_KEY_ID=schlussel-v1
SCHLUSSEL_TO_GLOCKE_HMAC_SECRET=replace-with-at-least-32-random-bytes
KUVERT_TO_GLOCKE_HMAC_KEY_ID=kuvert-v1
KUVERT_TO_GLOCKE_HMAC_SECRET=replace-with-at-least-32-random-bytes
TAFEL_TO_GLOCKE_HMAC_KEY_ID=tafel-v1
TAFEL_TO_GLOCKE_HMAC_SECRET=replace-with-at-least-32-random-bytes
ZETTEL_TO_GLOCKE_HMAC_KEY_ID=zettel-v1
ZETTEL_TO_GLOCKE_HMAC_SECRET=replace-with-at-least-32-random-bytes
GLOCKE_MAX_SKEW_SECONDS=300
GLOCKE_MAX_EVENT_BYTES=65536
GLOCKE_WORKER_INTERVAL_MS=1000
# Lease must exceed this timeout by at least 10000ms.
GLOCKE_RECIPIENT_FETCH_TIMEOUT_MS=5000
GLOCKE_WORKER_LEASE_MS=30000
# Glocke's own public origin - only used to turn a relative in-app actionUrl
# into an absolute push destination URL a service worker can open.
GLOCKE_PUBLIC_URL=https://glocke.localhost

# Browser Push (see backend/src/push-worker.ts). Disabled by default and
# requires no VAPID configuration when left off. Generate a keypair once
# with `npx web-push generate-vapid-keys` and keep it stable across
# deployments - rotating it requires every browser to re-subscribe.
GLOCKE_BROWSER_PUSH_ENABLED=false
GLOCKE_VAPID_SUBJECT=mailto:push@example.com
GLOCKE_VAPID_PUBLIC_KEY=replace-with-a-generated-vapid-public-key
GLOCKE_VAPID_PRIVATE_KEY=replace-with-a-generated-vapid-private-key
# Known browser-vendor push endpoint hosts; entries starting with "." match
# as a hostname suffix (covers Microsoft WNS's per-region hosts).
GLOCKE_PUSH_ALLOWED_ENDPOINT_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,web.push.apple.com,.notify.windows.com
# Optional tuning knobs; positive integers, shown defaults apply when unset.
# Fetch timeout must stay strictly below the push worker lease.
# GLOCKE_PUSH_FETCH_TIMEOUT_MS=10000
# GLOCKE_PUSH_WORKER_LEASE_MS=30000
# GLOCKE_PUSH_WORKER_INTERVAL_MS=1000
# GLOCKE_PUSH_MAX_ATTEMPTS=8
# GLOCKE_PUSH_RETRY_BASE_DELAY_MS=1000
# GLOCKE_PUSH_RETRY_MAX_DELAY_MS=21600000
# GLOCKE_PUSH_MAX_SUBSCRIPTIONS_PER_USER=10
# GLOCKE_PUSH_DELIVERY_RETENTION_MS=2592000000

# Direct backend runs do not load this file. Export the runtime names below;
# DATABASE_PATH, ALLOWED_ORIGINS, source origins, GLOCKE_EVENT_SOURCES, all five
# credentials, and the Schlussel/JWT settings are required. Timing values have
# the shown defaults when omitted.
# PORT=3004
# DATABASE_PATH=./data/glocke.db
# ALLOWED_ORIGINS=http://localhost:5177
# KUVERT_ORIGIN=http://localhost:5174
# TAFEL_ORIGIN=http://localhost:5175
# SCHLUSSEL_JWKS_URL=http://localhost:4000/.well-known/jwks.json
# SCHLUSSEL_INTERNAL_URL=http://localhost:4000
# JWT_ISSUER=schlussel
# GLOCKE_EVENT_SOURCES=schlussel,kuvert,tafel,zettel
# GLOCKE_SOURCE_KEY_ID_SCHLUSSEL=schlussel-v1
# GLOCKE_SOURCE_SECRET_SCHLUSSEL=<same value as SCHLUSSEL_TO_GLOCKE_HMAC_SECRET>
# GLOCKE_SOURCE_KEY_ID_KUVERT=kuvert-v1
# GLOCKE_SOURCE_SECRET_KUVERT=<same value as KUVERT_TO_GLOCKE_HMAC_SECRET>
# GLOCKE_SOURCE_KEY_ID_TAFEL=tafel-v1
# GLOCKE_SOURCE_SECRET_TAFEL=<same value as TAFEL_TO_GLOCKE_HMAC_SECRET>
# GLOCKE_SOURCE_KEY_ID_ZETTEL=zettel-v1
# GLOCKE_SOURCE_SECRET_ZETTEL=<same value as ZETTEL_TO_GLOCKE_HMAC_SECRET>
# GLOCKE_TO_SCHLUSSEL_HMAC_KEY_ID=glocke-v1
# GLOCKE_TO_SCHLUSSEL_HMAC_SECRET=<separate generated value accepted by Schlussel>

# Vite reads these from frontend/.env, not this root file. These are the
# built-in direct-development defaults.
# VITE_SCHLUSSEL_URL=http://localhost:4001
# VITE_SCHLOSS_URL=http://localhost:3000
